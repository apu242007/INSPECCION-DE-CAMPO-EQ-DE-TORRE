# Copiar a .env para desarrollo local. SIN estas variables la app corre en MODO DEMO:
# valida todo, arma el payload, lo imprime en consola y no manda nada a la red.
#
# ATENCION: todo lo que empieza con VITE_ se INLINEA en el bundle y es PUBLICO.
# Nunca poner acá un secreto real (contraseña de SP, client secret de Graph, token de Outlook).
# Esos viven solo dentro de las conexiones del flujo, que corren del lado del servidor.

VITE_BASE=/
VITE_EQT01_URL=
VITE_EQT02_URL=
VITE_EQT03_URL=
VITE_EQT04_URL=
VITE_EQT05_URL=

# Badén contra bots, NO autenticación: también viaja en el bundle.
VITE_TACKER_KEY=
